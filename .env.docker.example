# Copy to .env.docker and replace every "change-me" value before the first `docker compose up`.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=0
DJANGO_ALLOWED_HOSTS="localhost 127.0.0.1 [::1]"
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=api_prod_db
SQL_USER=api_prod_user
SQL_HOST=db
SQL_PORT=5432
DATABASE=postgres
REACT_APP_API_URL=http://127.0.0.1:8080/api/
POSTGRES_USER=api_prod_user
POSTGRES_DB=api_prod_db
CORS_ALLOWED_ORIGINS="http://nginx http://127.0.0.1:8080 http://localhost:8080"
PRE_PATH=api/
SECRET_KEY=change-me
SQL_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
REACT_URL=http://127.0.0.1:8080
MEDIA_URL='/api/media/'
STATIC_URL='/api/static/'
DJANGO_SUPERUSER_EMAIL='admin@example.com'
DJANGO_SUPERUSER_USERNAME='admin'
DJANGO_SUPERUSER_PASSWORD=change-me
TEST_PRE_PATH=http://127.0.0.1:8080/api
ANNOY_COMPILER_ARGS=-DNO_MANUAL_VECTORIZATION
