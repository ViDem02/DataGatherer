# start.sh / start.bat create .env.docker from this file on the first start, with random passwords.
# Setting it up by hand instead: copy to .env.docker and replace every "change-me" value, e.g. with
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=0
DJANGO_ALLOWED_HOSTS="localhost 127.0.0.1 [::1]"
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=api_prod_db
SQL_USER=api_prod_user
SQL_HOST=db
SQL_PORT=5432
DATABASE=postgres
POSTGRES_USER=api_prod_user
POSTGRES_DB=api_prod_db
CORS_ALLOWED_ORIGINS="http://nginx http://127.0.0.1:8080 http://localhost:8080"
PRE_PATH=api/
SECRET_KEY=change-me
SQL_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
REACT_URL=http://127.0.0.1:8080
MEDIA_URL='/api/media/'
STATIC_URL='/api/static/'
DJANGO_SUPERUSER_EMAIL='admin@example.com'
DJANGO_SUPERUSER_USERNAME='admin'
DJANGO_SUPERUSER_PASSWORD=change-me
TEST_PRE_PATH=http://127.0.0.1:8080/api
ANNOY_COMPILER_ARGS=-DNO_MANUAL_VECTORIZATION
# nginx is the only way in, so the client IP it reports (X-Real-IP) can be trusted for the login lockout
BEHIND_REVERSE_PROXY=1
# nginx sends uploaded files once Django has checked that the user may see them
MEDIA_ACCEL_REDIRECT_LOCATION=/protected_media/
# Set to 1 as soon as the site is served over HTTPS
SECURE_COOKIES=0
# Port of the app on this computer; start.sh / start.bat pick a free one on the first start
# APP_PORT=8080
